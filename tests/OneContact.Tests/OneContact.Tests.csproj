<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <!-- Real cultures must exist for the test that proves results ignore the current culture. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneContact/OneContact.csproj" />
    <ProjectReference Include="../../tools/Ingest/OneContact.Ingest.csproj" />
    <ProjectReference Include="../../tools/Ingest.Synthetic/OneContact.Ingest.Synthetic.csproj" />
  </ItemGroup>

  <!-- The synthetic source goes through the same path real data will: built by its tool, verified against its pin, embedded here. -->
  <ItemGroup>
    <IngestSource Include="synthetic"
                  Tool="../../tools/Ingest.Synthetic/OneContact.Ingest.Synthetic.csproj"
                  Pin="../../testdata/ingest-synthetic/PIN"
                  Files="../../testdata/ingest-synthetic/files" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../testdata/ingest-synthetic/**" Link="testdata/ingest-synthetic/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
