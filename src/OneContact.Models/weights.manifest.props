                  Recipe="recipes/models" Data="open address registers of the United States, Canada and 37 Tier 2 countries, names, companies and contact blocks; see PROVENANCE.md" Contents="shared fast-tier encoder; address-field head; name-part head; name-class head; contact-span head" />
  </ItemGroup>
</Project>
