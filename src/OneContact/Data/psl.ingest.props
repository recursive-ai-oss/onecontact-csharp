<Project>
  <ItemGroup>
    <IngestSource Include="psl" Tool="../../tools/Ingest.Psl/OneContact.Ingest.Psl.csproj" Pin="../../upstream/psl/PIN" />
  </ItemGroup>

  <!-- The list ships byte for byte as upstream published it, next to its licence; the compiled rule table is derived from this same file. -->
  <PropertyGroup>
    <_PslUpstream>$(ONECONTACT_UPSTREAM)</_PslUpstream>
    <_PslUpstream Condition="'$(_PslUpstream)' == ''">$(MSBuildThisFileDirectory)../../../.upstream</_PslUpstream>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(_PslUpstream)/psl/public_suffix_list.dat" Pack="true" PackagePath="notices/psl/" Link="notices/psl/public_suffix_list.dat" />
    <None Include="$(MSBuildThisFileDirectory)../../../upstream/psl/LICENSE" Pack="true" PackagePath="notices/psl/" Link="notices/psl/LICENSE" />
    <None Include="$(MSBuildThisFileDirectory)../../../upstream/unicode-idna/LICENSE" Pack="true" PackagePath="notices/unicode/" Link="notices/unicode/LICENSE" />
    <!-- Rules of ours, kept apart from the list so the list stays unmodified. -->
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../Web/Data/psl-additions.txt" LogicalName="OneContact.Data.psl-additions.txt" />
  </ItemGroup>
</Project>
