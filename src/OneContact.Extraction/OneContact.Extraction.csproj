<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>libphonenumber- and libpostal-class contact data for .NET: contact extraction for OneContact. Reads structured markup (JSON-LD, microdata, RDFa Lite, h-card, mailto and tel links, address elements) and visible text from web pages, plain text and sets of pages from one site into person and organization records, every field with its source, offsets, confidence and normalized value.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OneContact/OneContact.csproj" />
    <PackageReference Include="RecursiveAI.OneHtml" />
    <PackageReference Include="RecursiveAI.OneHtml.Accessibility" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(PackagePrefix)$(LibName).Tests" />
    <InternalsVisibleTo Include="$(PackagePrefix)$(LibName).Fuzz" />
    <InternalsVisibleTo Include="$(PackagePrefix)$(LibName).Eval" />
    <InternalsVisibleTo Include="$(PackagePrefix)$(LibName).Eval.Extraction" />
    <InternalsVisibleTo Include="$(PackagePrefix)$(LibName).Bench" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE-MIT" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE-APACHE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
