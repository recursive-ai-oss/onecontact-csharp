<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>libphonenumber- and libpostal-class contact data for .NET: Geocoder, carrier and time-zone mappers for phone numbers, an add-on to RecursiveAI.OneContact. The carrier mapper names the carrier a number range was first assigned to, which may not be its carrier today. In development.</Description>
  </PropertyGroup>

  <!-- Compiled data sets: each is declared by a Data/<name>.ingest.props file (see docs/architecture.md). -->
  <Import Project="Data/*.ingest.props" />

  <ItemGroup>
    <ProjectReference Include="../OneContact/OneContact.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(PackagePrefix)$(LibName).Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../PACKAGE.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE-MIT" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE-APACHE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
