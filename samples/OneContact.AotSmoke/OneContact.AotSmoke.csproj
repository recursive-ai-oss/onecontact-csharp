<Project Sdk="Microsoft.NET.Sdk">

  <!-- Publishes with NativeAOT and warnings as errors in CI: proves the library is AOT and trim clean and still works. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneContact/OneContact.csproj" />
    <ProjectReference Include="../../src/OneContact.Extraction/OneContact.Extraction.csproj" />
  </ItemGroup>

</Project>
