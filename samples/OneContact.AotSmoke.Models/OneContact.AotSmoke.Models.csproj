<Project Sdk="Microsoft.NET.Sdk">

  <!-- Publishes with NativeAOT and warnings as errors: proves the Tier 1 model package loads its embedded weights and runs after trimming.
       Build it with ONECONTACT_TIER1_WEIGHTS set to the folder holding the weights file listed in the package's manifest. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneContact.Models.Tier1/OneContact.Models.Tier1.csproj" />
    <!-- A package reference adds this file to the project by itself; a project reference does not. -->
    <Compile Include="../../src/OneContact.Models.Tier1/contentFiles/OneContactModelsTier1Registration.cs" Link="OneContactModelsTier1Registration.cs" />
  </ItemGroup>

</Project>
