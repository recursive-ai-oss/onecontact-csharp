<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Recursive AI libraries">
    <PackageVersion Include="RecursiveAI.OneHtml" Version="1.6.0-preview.1" />
    <PackageVersion Include="RecursiveAI.OneHtml.Accessibility" Version="1.6.0-preview.1" />
    <!-- Preview builds come from the local feeds named in ONECONTACT_LOCAL_FEEDS (see Directory.Build.props). -->
    <PackageVersion Include="RecursiveAI.OneNlp.Neural" Version="0.2.0-preview.1" />
    <PackageVersion Include="RecursiveAI.OneModel" Version="1.0.0" />
    <PackageVersion Include="RecursiveAI.OneModel.Training" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test, benchmark and fuzz projects only. Comparators and oracles are added here when a row needs one. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="libphonenumber-csharp" Version="9.0.42" />
    <PackageVersion Include="MimeKit" Version="4.18.2" />
    <!-- Comparator for the address parsing report: a regex parser for United States addresses, run as a black box. -->
    <PackageVersion Include="AddressParser" Version="1.0.3" />
    <PackageVersion Include="AngleSharp" Version="1.9.1" />
    <PackageVersion Include="Nager.PublicSuffix" Version="3.8.0" />
    <PackageVersion Include="NameParserSharp" Version="1.5.0" />
    <!-- Comparator for text extraction: sequence finding (email, phone number, URL), run as a black box. -->
    <PackageVersion Include="Microsoft.Recognizers.Text.Sequence" Version="1.8.13" />
  </ItemGroup>
</Project>
