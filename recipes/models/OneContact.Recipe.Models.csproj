<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Tier 1 + Tier 2 training recipe: turns the rendered training sets into examples and trains the shared encoder and its heads with OneNLP's Train. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OneContact.Recipe.Models</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <NoWarn>$(NoWarn);CA1303;CA1848;CA1307;CA1305;CA1310;CA1304;CA1311;CA1861;CA1869;CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneContact.Models/OneContact.Models.csproj" />
    <PackageReference Include="RecursiveAI.OneModel.Training" />
  </ItemGroup>

</Project>
