<Project Sdk="Microsoft.NET.Sdk">

  <!-- Measures how often the rule parser alone recovers every labelled field of the Tier 2 dev examples. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <NoWarn>$(NoWarn);CA1303;CA1848</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/OneContact/OneContact.csproj" />
  </ItemGroup>

</Project>
