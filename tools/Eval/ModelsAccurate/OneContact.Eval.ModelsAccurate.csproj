<Project Sdk="Microsoft.NET.Sdk">

  <!-- The same prediction writer as the rules tool, with the accurate-tier model registered from the saved pipeline named by ONECONTACT_ACCURATE_MODEL.
       A separate project so that only the accurate tier is registered. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <NoWarn>$(NoWarn);CA1303;CA1848;CA2255</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Rules/Program.cs" Link="Program.cs" />
    <ProjectReference Include="../../../src/OneContact.Models.Accurate/OneContact.Models.Accurate.csproj" />
  </ItemGroup>

</Project>
