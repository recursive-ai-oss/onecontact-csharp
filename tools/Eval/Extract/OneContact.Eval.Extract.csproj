<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the OneContact extractor over an extraction evaluation set, writes the pages' visible text for the reference systems and maps their
       character spans back to bytes of the page, and runs Microsoft.Recognizers.Text (a released package, run as a black box). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <AssemblyName>$(PackagePrefix)$(LibName).Eval</AssemblyName>
    <RootNamespace>OneContact.Eval.Extract</RootNamespace>
    <NoWarn>$(NoWarn);CA1303;CA1848;CA1031</NoWarn>
    <!-- The comparator package pulls in an old NuGet.CommandLine as a transitive dependency; this tool is never shipped. -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Recognizers.Text.Sequence" />
    <ProjectReference Include="../../../src/OneContact/OneContact.csproj" />
    <ProjectReference Include="../../../src/OneContact.Extraction/OneContact.Extraction.csproj" />
  </ItemGroup>

</Project>
