<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reads every item of address evaluation sets with the rules alone (no model package) and counts the honest-refusal outcomes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <NoWarn>$(NoWarn);CA1303;CA1848</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/OneContact/OneContact.csproj" />
  </ItemGroup>

</Project>
