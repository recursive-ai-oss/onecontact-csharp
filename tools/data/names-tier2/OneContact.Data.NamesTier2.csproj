<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders name and company examples for the Tier 2 languages: persons from our own language lists, companies from the GLEIF golden copy. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OneContact.Data.NamesTier2</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <NoWarn>$(NoWarn);CA1303;CA1848;CA1307;CA1305;CA1310;CA1304;CA1311;CA1859;CA1822;CA1002;CA1051;CA1034;CA5394;CA2201;CA1031;CA1812;CA1861;CA1865;CA1866;CA1867;CA1845;CA1847;CA1852;CA1869</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared with tools/data/names: the example builder and writer, the register readers, text helpers. Same namespace, compiled in. -->
    <Compile Include="../names/Example.cs;../names/Registers.cs;../names/Csv.cs;../names/Text.cs;../names/Prng.cs" />
    <None Include="lists.tsv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
